# Point this domain directly at the server. See the self-hosting guide for HTTPS.
PUBLIC_BASE_URL=https://share.example.com
STUN_URLS=stun:share.example.com:3478
MAX_VIEWERS_PER_ROOM=20
# Required: set a private passphrase before starting production.
SITE_ACCESS_PASSWORD=
# Set only the actual proxy source IP/CIDR seen inside the container.
# Empty ignores forwarding headers; all clients through one proxy share a limit.
TRUSTED_PROXY_CIDRS=

# Optional automatic media fallback: set BOTH values and allow UDP 7882.
# SFU_UDP_PORT=7882
# SFU_PUBLIC_IP=203.0.113.10

# Optional NAT survey: also allow UDP 3479 and 3480.
# NAT_PREDICTION_ENABLED=true

# Build this fork's image using the self-hosting guide before starting Compose.
PIIK_IMAGE=piik:self-hosted
